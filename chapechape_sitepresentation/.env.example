# ==============================================
# CHAPECHAPE RESIDENCE - SITE VITRINE CONFIGURATION
# ==============================================
# Fichier .env.example - Template sécurisé pour le déploiement
# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs

# ==============================================
# GOOGLE ANALYTICS 4
# ==============================================
# Remplacez par votre vrai ID de mesure GA4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================
# API CONFIGURATION
# ==============================================
# Backend API URLs
VITE_API_BASE_URL=http://localhost:4000/api  # Development
# VITE_API_BASE_URL=https://api.chapechaperesidence.com/api  # Production

# ==============================================
# URLS CONFIGURATION
# ==============================================
# Site URLs
VITE_SITE_URL=http://localhost:5173  # Development
# VITE_SITE_URL=https://presentation.chapechaperesidence.com  # Production

# Applications URLs
VITE_CLIENT_APP_URL=https://client.chapechaperesidence.com
VITE_PARTNER_APP_URL=https://partner.chapechaperesidence.com
VITE_ADMIN_APP_URL=https://admin.chapechaperesidence.com

# ==============================================
# APPLICATION INFO
# ==============================================
VITE_APP_NAME=ChapeChape Residence
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Plateforme de gestion de résidences étudiantes en Afrique de l'Ouest

# ==============================================
# FEATURES FLAGS
# ==============================================
# Analytics
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_GA4=true
VITE_ENABLE_HOTJAR=false

# Development Tools
VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_REDUX_DEVTOOLS=false
VITE_ENABLE_CONSOLE_LOGS=false

# UI Features
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_BLOG=true
VITE_ENABLE_NEWSLETTER=true
VITE_ENABLE_CONTACT_FORM=true

# ==============================================
# CONTACT INFORMATION
# ==============================================
VITE_CONTACT_EMAIL=contact@chapechaperesidence.com
VITE_SUPPORT_EMAIL=support@chapechaperesidence.com
VITE_PHONE_NUMBER=+225 01 02 03 04 05
VITE_ADDRESS=Abidjan, Côte d'Ivoire

# ==============================================
# SOCIAL MEDIA
# ==============================================
VITE_FACEBOOK_URL=https://facebook.com/chapechaperesidence
VITE_TWITTER_URL=https://twitter.com/chapechaperesidence
VITE_INSTAGRAM_URL=https://instagram.com/chapechaperesidence
VITE_LINKEDIN_URL=https://linkedin.com/company/chapechaperesidence
VITE_YOUTUBE_URL=https://youtube.com/@chapechaperesidence

# ==============================================
# APP STORE LINKS
# ==============================================
# Client App
VITE_CLIENT_IOS_URL=https://apps.apple.com/app/chapechape-client
VITE_CLIENT_ANDROID_URL=https://play.google.com/store/apps/details?id=com.chapechape.client

# Partner App
VITE_PARTNER_IOS_URL=https://apps.apple.com/app/chapechape-partner
VITE_PARTNER_ANDROID_URL=https://play.google.com/store/apps/details?id=com.chapechape.partner

# ==============================================
# SEO CONFIGURATION
# ==============================================
VITE_SEO_TITLE=ChapeChape Residence | Logements étudiants en Afrique de l'Ouest
VITE_SEO_DESCRIPTION=Trouvez et gérez facilement vos logements étudiants en Afrique de l'Ouest avec ChapeChape Residence. Plateforme sécurisée pour étudiants et propriétaires.
VITE_SEO_KEYWORDS=logement étudiant,résidence étudiante,Afrique de l'Ouest,Côte d'Ivoire,hébergement,ChapeChape
VITE_SEO_AUTHOR=ChapeChape Residence
VITE_SEO_SITE_NAME=ChapeChape Residence

# ==============================================
# PERFORMANCE CONFIGURATION
# ==============================================
# Cache settings
VITE_CACHE_VERSION=1.0.0
VITE_ENABLE_SERVICE_WORKER=true

# Image optimization
VITE_IMAGE_OPTIMIZATION=true
VITE_LAZY_LOADING=true

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
# CORS settings
VITE_CORS_ENABLED=true

# Content Security Policy
VITE_CSP_ENABLED=false

# ==============================================
# ENVIRONMENT SPECIFIC
# ==============================================
# Environment indicator
VITE_NODE_ENV=development  # development | production | staging

# Debug settings
VITE_DEBUG_MODE=false
VITE_VERBOSE_LOGGING=false

# ==============================================
# THIRD PARTY SERVICES
# ==============================================
# Maps
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# reCAPTCHA (si nécessaire)
# VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Crisp Chat (si nécessaire)
# VITE_CRISP_WEBSITE_ID=your_crisp_website_id

# ==============================================
# INSTRUCTIONS D'INSTALLATION
# ==============================================
# 1. Copiez ce fichier vers .env
# 2. Remplacez tous les placeholders par vos vraies valeurs
# 3. Configurez Google Analytics avec votre vrai ID
# 4. Ajustez les URLs selon votre environnement (dev/prod)
# 5. Configurez les liens vers les app stores quand disponibles
# 6. Testez toutes les intégrations
#
# SÉCURITÉ: Ne jamais commiter le fichier .env dans Git!
# Le fichier .env est déjà dans .gitignore
