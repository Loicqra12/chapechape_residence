# ==============================================
# CHAPECHAPE RESIDENCE - BACKEND CONFIGURATION
# ==============================================
# Fichier .env.example - Template sécurisé pour le déploiement
# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs

# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=4000
NODE_ENV=development  # development | production | staging

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# MongoDB Atlas Connection (Production)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# MongoDB Local Connection (Development)
# MONGODB_URI=mongodb://localhost:27017/chapechape

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRE=24h
JWT_COOKIE_EXPIRE=24
JWT_REFRESH_SECRET=your_super_secure_refresh_token_secret_here
# Durée de validité du refresh token en JOURS (ex: 30 = 1 mois, 60 = 2 mois pour rester connecté longtemps)
JWT_REFRESH_EXPIRE=60

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
# SMTP Configuration (Brevo/Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=noreply@chapechaperesidence.com
SMTP_PASS=your_brevo_smtp_password
EMAIL_FROM=ChapeChape Residences <noreply@chapechaperesidence.com>
EMAIL_REPLY_TO=support@chapechaperesidence.com
EMAIL_CONTACT=contact@chapechaperesidence.com
EMAIL_SUPPORT=support@chapechaperesidence.com
EMAIL_ADMIN=admin@chapechaperesidence.com
EMAIL_TEMPLATE_PATH=src/templates/emails

# ==============================================
# BREVO CONFIGURATION (SENDINBLUE)
# ==============================================
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxx
# Expéditeur API transactionnelle : adresse vérifiée dans Brevo (obligatoire si EMAIL_USERNAME est xxx@smtp-brevo.com)
BREVO_SENDER_EMAIL=noreply@chapechaperesidence.com
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USERNAME=xxxxxxxxx@smtp-brevo.com
EMAIL_PASSWORD=your_brevo_email_password

# Templates Brevo IDs - Décommentez et ajoutez les IDs quand vous aurez créé vos templates
# BREVO_WELCOME_TEMPLATE_ID=1
# BREVO_BOOKING_TEMPLATE_ID=2
# BREVO_CANCELLATION_TEMPLATE_ID=3
# BREVO_RESET_PASSWORD_TEMPLATE_ID=4
# BREVO_NOTIFICATION_TEMPLATE_ID=5
# BREVO_PARTNER_NEW_BOOKING_TEMPLATE_ID=6
# BREVO_PARTNER_CANCELLATION_TEMPLATE_ID=7

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5000000
MAX_FILES_PER_UPLOAD=5
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS Configuration - Autoriser les connexions depuis l'application mobile
CORS_ORIGIN=http://localhost:3000,capacitor://localhost,http://192.168.1.77:*,http://localhost:*
PASSWORD_RESET_EXPIRE=600
MAX_LOGIN_ATTEMPTS=5
BLOCK_DURATION=900

# ==============================================
# ANTIVIRUS CONFIGURATION (CLAMAV)
# ==============================================
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMDSCAN_PATH=/usr/bin/clamdscan
ACTIVATE_VIRUS_SCAN=false

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
# true = rate limiting en mémoire même hors NODE_ENV=development (tests / secours)
# RATE_LIMIT_USE_MEMORY=false

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ==============================================
# PARTNER CONFIGURATION
# ==============================================
SUBSCRIPTION_TRIAL_DAYS=30
MAX_RESIDENCES_FREE=5

# ==============================================
# MEDIA CONFIGURATION
# ==============================================
MEDIA_STORAGE_PATH=public/media
THUMBNAIL_SIZES=150,500,800
IMAGE_QUALITY=80

# ==============================================
# CINETPAY TRANSFER CONFIGURATION
# ==============================================
# CinetPay Transfer API - Pour les payouts automatiques
CINETPAY_TRANSFER_API_KEY=your_cinetpay_transfer_api_key_here
CINETPAY_TRANSFER_PASSWORD=your_cinetpay_transfer_api_password_here
CINETPAY_TRANSFER_BASE_URL=https://client.cinetpay.com/v1
# Secret header pour webhooks reversement CinetPay (header x-webhook-secret)
CINETPAY_TRANSFER_WEBHOOK_SECRET=your_cinetpay_transfer_webhook_secret_here

# Email de notification pour confirmations CinetPay
CINETPAY_NOTIFICATION_EMAIL=admin@chapechape.com

# Payout Configuration
DEFAULT_COMMISSION_RATE=0.10
PAYOUT_DELAY_HOURS=1
MAX_PAYOUT_RETRY_ATTEMPTS=3

# ==============================================
# CHAT CONFIGURATION
# ==============================================
CHAT_MESSAGE_LIMIT=50
CHAT_FILE_SIZE_LIMIT=2000000
CHAT_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ==============================================
# NOTIFICATION CONFIGURATION
# ==============================================
NOTIFICATION_CLEANUP_DAYS=30
NOTIFICATION_BATCH_SIZE=100

# ==============================================
# ONESIGNAL CONFIGURATION
# ==============================================
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
# Le backend utilise ONESIGNAL_REST_API_KEY en priorité, puis fallback sur ONESIGNAL_API_KEY.

# ==============================================
# CACHE CONFIGURATION
# ==============================================
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# ==============================================
# CLOUDINARY CONFIGURATION
# ==============================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ==============================================
# WAVE CONFIGURATION
# ==============================================
WAVE_API_KEY=your_wave_api_key_here
WAVE_API_SECRET=your_wave_api_secret_here
WAVE_SIGNING_SECRET=your_wave_signing_secret_here
# Secret affiché dans Wave Business → Webhooks → Payouts (peut être identique à WAVE_SIGNING_SECRET)
WAVE_PAYOUT_WEBHOOK_SECRET=your_wave_payout_webhook_signing_secret_here
WAVE_PAYOUT_API_KEY=your_wave_payout_api_key_here
WAVE_BASE_URL=https://api.wave.com/v1

# Configuration Payout Automatique
AUTO_PAYOUT_ENABLED=true
MIN_PAYOUT_AMOUNT=1000
AUTO_PAYOUT_DELAY_MINUTES=5
AUTO_PAYOUT_IMMEDIATE=false
PAYOUT_RETRY_ATTEMPTS=3

# ==============================================
# CINETPAY PAYMENT CONFIGURATION
# ==============================================
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
CINETPAY_SECRET_KEY=your_cinetpay_secret_key
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_NOTIFY_URL=https://yourdomain.com/api/payments/cinetpay/webhook
CINETPAY_RETURN_URL=https://yourapp.com/payment/success
# Laisser vide ou absent : le webhook exige le header x-token (HMAC doc CinetPay).
# Mettre true uniquement pour tests locaux si CinetPay n’envoie pas x-token.
# CINETPAY_WEBHOOK_DISABLE_SIGNATURE_CHECK=false

# ==============================================
# WAVE PAYMENT CONFIGURATION
# ==============================================
# Réutilise WAVE_API_KEY défini dans la section WAVE CONFIGURATION
WAVE_BASE_URL=https://api.wave.com
WAVE_SUCCESS_URL=https://yourapp.com/payment/success
WAVE_ERROR_URL=https://yourapp.com/payment/error
WAVE_WEBHOOK_URL=https://yourdomain.com/api/payments/wave/webhook


# ==============================================
# PAYMENT CONFIGURATION
# ==============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ==============================================
# SMS & WHATSAPP CONFIGURATION
# ==============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
TWILIO_WHATSAPP_NUMBER=whatsapp:+10000000000
# Plafond envois SMS libres (POST /api/sms/send) par utilisateur authentifié / heure (défaut 40)
SMS_SEND_MAX_PER_HOUR=40
# Pays par défaut pour normalisation E.164 si le numéro n’est pas déjà international (défaut CI)
DEFAULT_PHONE_COUNTRY=CI

# ==============================================
# SOCIAL AUTHENTICATION
# ==============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ==============================================
# MAPS CONFIGURATION
# ==============================================
GOOGLE_MAPS_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# MONITORING & APM CONFIGURATION
# ==============================================

# New Relic Configuration
NEW_RELIC_LICENSE_KEY_USER=NRAK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=ChapeChape-Residence-Backend
NEW_RELIC_ACCOUNT_ID=your_account_id
NEW_RELIC_LOG_LEVEL=info
NEW_RELIC_ENABLED=true

# Sentry Configuration
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oxxxxxxxxxxxxxxxxxxxx.ingest.us.sentry.io/xxxxxxxxxxxx
SENTRY_ENVIRONMENT=development  # development | production | staging
SENTRY_RELEASE=1.0.0

# ==============================================
# PRODUCTION CONFIGURATION
# ==============================================
# URLs de production (utilisées par src/app.js pour CORS — site vitrine LWS, etc.)
PRODUCTION_FRONTEND_URL=https://presentation.chapechaperesidence.com
PRODUCTION_API_URL=https://api.chapechaperesidence.com
PRODUCTION_CORS_ORIGIN=https://presentation.chapechaperesidence.com
PRODUCTION_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chapechape_prod

# IP Restrictions for Production (Brevo Security)
# Ajouter les IPs autorisées séparées par des virgules
ALLOWED_IPS_PRODUCTION=your_server_ip,your_office_ip
ENABLE_IP_RESTRICTIONS=false  # Passer à true en production avec restrictions IP

# SSL/Security Configuration for Production
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem
FORCE_HTTPS=true
SECURE_COOKIES=true
SAME_SITE_COOKIES=strict

# ==============================================
# INSTRUCTIONS D'INSTALLATION
# ==============================================
# 1. Copiez ce fichier vers .env
# 2. Remplacez tous les placeholders par vos vraies valeurs
# 3. Configurez votre base de données MongoDB
# 4. Configurez vos services externes (Brevo, Cloudinary, etc.)
# 5. Générez des secrets JWT sécurisés
# 6. Configurez les restrictions IP pour la production
# 7. Activez le monitoring (New Relic, Sentry)
#
# SÉCURITÉ: Ne jamais commiter le fichier .env dans Git!
# Le fichier .env est déjà dans .gitignore
