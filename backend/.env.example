# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/chapechape

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=24h
JWT_COOKIE_EXPIRE=24

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=ChapeChape Residences <noreply@chapechape.com>
EMAIL_TEMPLATE_PATH=src/templates/emails

# Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5000000
MAX_FILES_PER_UPLOAD=5
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Security Configuration
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:3000
PASSWORD_RESET_EXPIRE=600
MAX_LOGIN_ATTEMPTS=5
BLOCK_DURATION=900

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Partner Configuration
SUBSCRIPTION_TRIAL_DAYS=30
MAX_RESIDENCES_FREE=5

# Media Configuration
MEDIA_STORAGE_PATH=public/media
THUMBNAIL_SIZES=150,500,800
IMAGE_QUALITY=80

# Chat Configuration
CHAT_MESSAGE_LIMIT=50
CHAT_FILE_SIZE_LIMIT=2000000
CHAT_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Notification Configuration
NOTIFICATION_CLEANUP_DAYS=30
NOTIFICATION_BATCH_SIZE=100

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# Payment Configuration
STRIPE_SECRET_KEY=sk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example

# SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FILE_UPLOAD_MAX_SIZE=5242880

# Social Authentication
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
