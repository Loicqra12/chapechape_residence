{
  "name": "chapechape-residences-backend",
  "version": "1.0.1",
  "description": "Backend pour l'application ChapeChape Residences",
  "main": "src/server.js",
  "scripts": {
    "start": "node -r newrelic src/server.js",
    "dev": "nodemon -r newrelic src/server.js",
    "test": "node scripts/run-jest-supported.js",
    "test:manual:performance": "node tests/manual/performance-probe.js",
    "test:p2": "jest tests/unit/runtime/p2-01-runtime.test.js tests/unit/security/p2-02-permissions.test.js tests/unit/security/p2-02-publication.test.js tests/unit/security/p2-02-idor.test.js tests/unit/security/p2-02-staff.test.js tests/unit/security/p2-02-rate-limit.test.js --coverage=false --testTimeout=120000",
    "test:ci": "jest tests/unit/services/reservation-inventory.p0.test.js tests/unit/services/host-approval.p1.test.js tests/unit/services/partner-block.p1.test.js tests/unit/services/external-reservation.p1.test.js tests/unit/services/calendar-projection.p1.test.js tests/unit/services/reservation-status.p1.test.js tests/unit/services/ops-admin.p1.test.js tests/unit/services/stay-lifecycle.p2-05b.test.js tests/unit/services/stay-credential.p2-05c2.test.js tests/unit/services/stay-credential.hardening.p2-05c2.test.js tests/unit/runtime/p2-01-runtime.test.js tests/unit/security/p2-02-permissions.test.js tests/unit/security/p2-02-publication.test.js tests/unit/security/p2-02-idor.test.js tests/unit/security/p2-02-staff.test.js tests/unit/security/p2-02-rate-limit.test.js tests/unit/security/p2-03-quarantine-guard.test.js tests/unit/middleware/csrf.test.js tests/unit/middleware/p2-08c-csrf-production-contract.test.js tests/unit/middleware/security.test.js tests/unit/observability/p2-04-lot0.test.js tests/unit/observability/p2-04-lot1.test.js tests/unit/observability/p2-04-lot2.test.js tests/unit/socket/p2-06b-reservation-realtime.test.js tests/unit/push/p2-06c-push-preferences.test.js tests/unit/presence/p2-06d-distributed-presence.test.js tests/unit/cleanup/p2-07b-dead-code-removal.test.js tests/unit/agenda/p2-07c-arrival-reminder-idempotence.test.js tests/unit/notifications/p2-07f-legacy-enum-convergence.test.js tests/unit/notifications/p2-07f-final-compatibility-gate.test.js tests/unit/socket/p2-07g-socket-alias-review.test.js tests/unit/scripts/p2-09b0-prod-audit-hardening.test.js --coverage=false --testTimeout=180000",
    "test:p1": "npm run test:ci",
    "test:p2-02": "jest tests/unit/security/p2-02-permissions.test.js tests/unit/security/p2-02-publication.test.js tests/unit/security/p2-02-idor.test.js tests/unit/security/p2-02-staff.test.js tests/unit/security/p2-02-rate-limit.test.js --coverage=false --testTimeout=120000",
    "test:p1-06": "jest tests/unit/services/reservation-status.p1.test.js --coverage=false --testTimeout=60000",
    "test:p1-07": "jest tests/unit/services/ops-admin.p1.test.js --coverage=false --testTimeout=180000",
    "audit:reservation-status": "node scripts/audit-reservation-status.js",
    "audit:notification-types": "node scripts/audit-notification-type-values.js",
    "verify:stay-credential-duplicates": "node scripts/verify-stay-credential-duplicates.js",
    "verify:stay-credential-indexes": "node scripts/verify-stay-credential-indexes.js",
    "test:p1-01": "jest tests/unit/services/host-approval.p1.test.js --coverage=false --testTimeout=180000",
    "test:p1-02": "jest tests/unit/services/partner-block.p1.test.js --coverage=false --testTimeout=180000",
    "test:p1-03": "jest tests/unit/services/external-reservation.p1.test.js --coverage=false --testTimeout=180000",
    "test:p1-04": "jest tests/unit/services/calendar-projection.p1.test.js --coverage=false --testTimeout=180000",
    "test:legacy": "node scripts/run-jest-legacy.js",
    "test:critical": "jest tests/unit/services/reservation-inventory.p0.test.js --coverage=false --testTimeout=180000",
    "verify:inventory": "node scripts/verify-inventory-indexes.js",
    "fingerprint:mongo": "node scripts/fingerprint-mongo-env.js",
    "prod:baseline": "node scripts/prod-runtime-baseline.js",
    "prod:config-presence": "node scripts/audit-prod-config.js",
    "audit:reservations": "node scripts/audit-reservation-consistency.js",
    "audit:reservations:details": "node scripts/audit-reservation-details.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:validations": "jest tests/validations --coverage=false",
    "test:api": "jest 'tests/(?!.*validation-schemas).*'",
    "test:unit": "jest 'tests/unit/**/*.test.js'",
    "test:load": "artillery run tests/load/auth-residence-load.yml",
    "test:load:report": "artillery run --output report.json tests/load/auth-residence-load.yml && artillery report report.json",
    "generate:data": "node scripts/generate-test-data.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "backup": "bash scripts/backup.sh",
    "deploy": "bash scripts/start.sh",
    "docs": "swagger-jsdoc -d src/config/swagger.js -o public/swagger.json && serve public",
    "security:audit": "npm audit && snyk test",
    "db:seed": "node scripts/generate-test-data.js",
    "db:migrate": "node scripts/migrations/run.js",
    "clean": "rimraf logs/* tmp/* coverage/*",
    "monitor": "pm2 monit",
    "create-superadmin": "node src/scripts/createSuperAdmin.js",
    "seed:roles-permissions": "node src/scripts/seedRolesPermissions.js"
  },
  "dependencies": {
    "@sentry/node": "^9.40.0",
    "@sentry/profiling-node": "^9.40.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "agenda": "^5.0.0",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.6.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-csrf": "^0.3.4",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "global-agent": "^3.0.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "http-status": "^2.1.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonpath-plus": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "newrelic": "^12.25.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.11",
    "rate-limit-redis": "^4.3.1",
    "response-time": "^2.3.3",
    "sharp": "^0.33.1",
    "sib-api-v3-sdk": "^8.5.0",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.6.1",
    "validator": "^13.15.23",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.20",
    "@faker-js/faker": "^8.0.0",
    "artillery": "^2.0.23",
    "babel-jest": "^29.7.0",
    "chai": "^5.2.0",
    "eslint": "^9.19.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "punycode": "^2.3.1",
    "sinon": "^21.0.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/votre-repo/chapechape-residences.git"
  },
  "keywords": [
    "residences",
    "booking",
    "api",
    "nodejs",
    "express"
  ],
  "author": "ChapeChape Team",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/votre-repo/chapechape-residences/issues"
  },
  "homepage": "https://github.com/votre-repo/chapechape-residences#readme"
}
