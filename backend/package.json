{
  "name": "chapechape-residences-backend",
  "version": "1.0.0",
  "description": "Backend pour l'application ChapeChape Residences",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:load": "artillery run tests/load/load-test.yml",
    "test:load:report": "artillery run --output report.json tests/load/load-test.yml && artillery report report.json",
    "generate:data": "node scripts/generate-test-data.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "backup": "bash scripts/backup.sh",
    "deploy": "bash scripts/start.sh",
    "docs": "swagger-jsdoc -d src/config/swagger.js -o public/swagger.json && serve public",
    "security:audit": "npm audit && snyk test",
    "db:seed": "node scripts/generate-test-data.js",
    "db:migrate": "node scripts/migrations/run.js",
    "clean": "rimraf logs/* tmp/* coverage/*",
    "monitor": "pm2 monit",
    "create-superadmin": "node src/scripts/createSuperAdmin.js"
  },
  "dependencies": {
    "agenda": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-pino-logger": "^7.0.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.16",
    "response-time": "^2.3.3",
    "sharp": "^0.33.1",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.0.0",
    "artillery": "^2.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.20",
    "babel-jest": "^29.7.0",
    "eslint": "^9.19.0",
    "ioredis-mock": "^8.9.0",
    "punycode": "^2.3.1",
    "redis": "^4.7.0",
    "redis-mock": "^0.56.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/votre-repo/chapechape-residences.git"
  },
  "keywords": [
    "residences",
    "booking",
    "api",
    "nodejs",
    "express"
  ],
  "author": "ChapeChape Team",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/votre-repo/chapechape-residences/issues"
  },
  "homepage": "https://github.com/votre-repo/chapechape-residences#readme"
}
